# -------------------------
# .gitignore unificado para TFG
# -------------------------

# -------------------------
# Sistema / SO
# -------------------------
.DS_Store
Thumbs.db
desktop.ini
.AppleDouble
.LSOverride
._*

# -------------------------
# IDEs / Editores
# -------------------------
.vscode/
.idea/
.shelf/
workspace.xml
*.iml
*.sublime-project
*.sublime-workspace

# -------------------------
# Python
# -------------------------
# Entornos virtuales
venv/
.venv/
env/
ENV/
# Byte-compiled / Caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
# Distribución / Build
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
*.manifest
*.spec
# Entornos / Secrets
.env
.env.*
# Jupyter
.ipynb_checkpoints/
# Coverage / Test outputs
.coverage
.coverage.*
htmlcov/

# -------------------------
# Node / Frontend
# -------------------------
node_modules/
public/build/
.pnp.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# -------------------------
# Android / Java / Gradle / Mobile
# -------------------------
# Build outputs (el comodín **/build/ ignora la carpeta build en cualquier nivel)
**/build/
/captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
# Gradle y Config local (CRÍTICO: NO SUBIR)
.gradle/
.gradle-cache/
local.properties
*.properties
# Excepción: mantener gradle.properties (si contiene configuraciones o keys necesarias)
!gradle.properties
# Keystores y firmas
*.keystore
*.jks
# iOS (por si usas React Native / Expo)
ios/Pods/

# -------------------------
# Datos, Modelos y Outputs (Pesados)
# -------------------------
backend/modelos/ 
backend/reportes/
**/Ejemplos/
**/datasets/
**/data/
**/dataset/
**/raw_data/
# Checkpoints de Modelos / Pesos
*.h5
*.pt
*.pth
*.ckpt
*.tflite
*.npy
# TensorBoard logs, training outputs
logs/
tensorboard/
runs/

# -------------------------
# Binarios / Archivos comprimidos / Media
# -------------------------
*.exe
*.bat
*.dll
*.so
*.dylib
*.class
*.jar
*.war
*.zip
*.tar.gz
*.rar
*.png
*.mp4
*.docx

# -------------------------
# Varios / Logs
# -------------------------
*.log
landmarcks.txt

# -------------------------
# Excepciones personalizadas
# -------------------------
**/.claude/
.claude/
api.py
rescate.py
revisar.py
# Si quieres mantener archivos específicos que caen en las reglas anteriores, 
# añádelos aquí abajo con un "!" al principio. Ejemplo:
# !backend/angles_per_frame.csv*.npz

# Scripts de preparación de la demo (no publicar)
backend/redate_demo.py
backend/seed_demo.py
# Salida de compilación firmada de Android
frontend/app/release/
