<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Las IPs nunca se resuelven por <domain-config> — solo los hostnames.
        Para permitir HTTP a una IP hay que habilitarlo en <base-config>.
        Esto es aceptable para un entorno de desarrollo local (TFG).
        En producción el backend usaría HTTPS y un dominio real.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>